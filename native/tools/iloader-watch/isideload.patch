+            (Some(DeveloperDeviceType::Tvos), "tvos/"),
+            (Some(DeveloperDeviceType::Any), ""),
+        ] {
+            let mut body = Dictionary::new();
+            apply_platform_to_body(&mut body, &kind);
+            assert!(!body.contains_key("DTDK_Platform"));
+            assert!(
+                dev_url("listDevices", kind).contains(&format!("/QH65B2/{path}listDevices.action"))
+            );
+        }
+    }
