+            let mut body = Dictionary::new();
+            body.insert("teamId".into(), Value::String("test-team".into()));
+            apply_platform_to_body(&mut body, &device_type);
+            let url = dev_url(endpoint, device_type);
+            assert!(url.contains(&format!("/ios/{endpoint}.action")));
+            assert_eq!(
+                body.get("DTDK_Platform").and_then(Value::as_string),
+                Some("watchos")
+            );
+            assert_eq!(
+                body.get("teamId").and_then(Value::as_string),
+                Some("test-team")
+            );
+        }
+    }
