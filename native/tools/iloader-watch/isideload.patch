+    fn rewritten_child_id(id: &str, old_host: &str, new_host: &str) -> Result<String, Report> {
+        let suffix = id
+            .strip_prefix(old_host)
+            .filter(|suffix| suffix.starts_with('.'));
+        match suffix {
+            Some(suffix) => Ok(format!("{new_host}{suffix}")),
+            None => bail!(SideloadError::InvalidBundle(format!(
+                "Nested app identifier {id} is not a child of {old_host}"
+            ))),
+        }
+    }
+
+    fn rewrite_reference(
+        info: &mut Dictionary,
+        key: &str,
+        old_host: &str,
+        new_host: &str,
+    ) -> Result<(), Report> {
+        if let Some(value) = info.get_mut(key) {
+            let id = value
+                .as_string()
+                .ok_or_else(|| report!("{key} must be a bundle identifier string"))?;
+            let rewritten = if id == old_host {
+                new_host.to_string()
+            } else {
+                Self::rewritten_child_id(id, old_host, new_host)?
+            };
+            *value = Value::String(rewritten);
+        }
+        Ok(())
+    }
+
+    pub fn rewrite_embedded_bundle_ids(
+        &mut self,
+        old_host: &str,
+        new_host: &str,
+    ) -> Result<(), Report> {
+        // Older WatchKit extensions link back to the Watch app in this nested
+        // dictionary; rewriting only CFBundleIdentifier breaks that relationship.
+        Self::rewrite_reference(
+            &mut self.app_info,
+            "WKAppBundleIdentifier",
+            old_host,
+            new_host,
+        )?;
+        if let Some(attributes) = self
+            .app_info
+            .get_mut("NSExtension")
+            .and_then(Value::as_dictionary_mut)
+            .and_then(|extension| extension.get_mut("NSExtensionAttributes"))
+            .and_then(Value::as_dictionary_mut)
+        {
+            Self::rewrite_reference(attributes, "WKAppBundleIdentifier", old_host, new_host)?;
+        }
+
+        for extension in &mut self.app_extensions {
+            let id = extension
+                .bundle_identifier()
+                .ok_or_else(|| report!("Extension is missing CFBundleIdentifier"))?;
+            let rewritten = Self::rewritten_child_id(id, old_host, new_host)?;
+            extension.set_bundle_identifier(&rewritten);
+            extension.rewrite_embedded_bundle_ids(old_host, new_host)?;
+        }
+        for watch in &mut self.watch_apps {
+            if let Some(companion) = watch.app_info.get("WKCompanionAppBundleIdentifier") {
+                if companion.as_string() != Some(old_host) {
+                    bail!(SideloadError::InvalidBundle(
