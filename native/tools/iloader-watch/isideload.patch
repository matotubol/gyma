+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn refuses_missing_or_ambiguous_watch() {
+        assert!(single_watch_udid(&[]).is_err());
+        assert!(single_watch_udid(&["one".into(), "two".into()]).is_err());
+        assert_eq!(
+            single_watch_udid(&["only-watch".into()]).unwrap(),
+            "only-watch"
+        );
+        assert!(ensure_watch_identity("registered-watch", "other-watch").is_err());
+        assert!(ensure_watch_identity("WATCH-ID", "watch-id").is_ok());
+    }
+
+    #[test]
+    fn only_explicit_placeholders_can_be_removed() {
+        let mut app = Dictionary::new();
+        assert!(!is_explicit_placeholder(&Value::Dictionary(app.clone())));
+        app.insert("IsPlaceholder".into(), Value::Boolean(false));
+        assert!(!is_explicit_placeholder(&Value::Dictionary(app.clone())));
+        app.insert("IsPlaceholder".into(), Value::String("true".into()));
+        assert!(!is_explicit_placeholder(&Value::Dictionary(app.clone())));
+        app.insert("IsPlaceholder".into(), Value::Boolean(true));
+        assert!(is_explicit_placeholder(&Value::Dictionary(app)));
+    }
+
+    #[test]
+    fn bounds_untrusted_watch_response_lengths() {
+        assert!(validate_plist_length(0).is_err());
+        assert!(validate_plist_length(MAX_WATCH_PLIST_BYTES + 1).is_err());
+        assert!(validate_plist_length(256).is_ok());
+    }
+
+    #[test]
+    fn install_complete_and_remote_errors_are_distinct() {
+        let mut response = Dictionary::new();
+        response.insert("Status".into(), Value::String("DataComplete".into()));
+        assert_eq!(
+            install_response(&response).unwrap(),
+            WatchInstallResponse::Complete
+        );
+        let mut progress = Dictionary::new();
+        progress.insert(
+            "Error".into(),
+            Value::String("ApplicationVerificationFailed".into()),
+        );
+        progress.insert(
+            "ErrorDescription".into(),
+            Value::String("Developer Mode is disabled".into()),
+        );
+        response.insert("InstallProgressDict".into(), Value::Dictionary(progress));
+        let error = install_response(&response).unwrap_err().to_string();
+        assert!(error.contains("ApplicationVerificationFailed"));
+        assert!(error.contains("Developer Mode is disabled"));
+        assert!(install_response(&Dictionary::new()).is_err());
+    }
+
+    #[test]
+    fn streaming_crc_matches_standard_vector() {
+        assert_eq!(crc32_ieee(b"123456789"), 0xcbf4_3926);
+    }
+}
